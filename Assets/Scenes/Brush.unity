  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02b52d6902917fc408ad57998e321d15, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _currentScene: Brush
  _motherCatRoot: {fileID: 1199070764}
  _motherCatSpine: {fileID: 1199070766}
  _dialoguePoint: {x: -3, y: -3.64}
  _triggerRadius: 1.2
  _dialogueUI: {fileID: 727567611}
  _lines:
  - speaker: 1
    content: "\u8FD9\u662F\u4EC0\u4E48\uFF1F\u4E00\u4E2A\u4F1A\u52A8\u7684\u4EBA\u5076\uFF1F"
  - speaker: 0
    content: "\u54C7\uFF01\u597D\u53EF\u7231\u7684\u54AA\u54AA\uFF01"
  - speaker: 1
    content: "\u6CA1\u793C\u8C8C\u7684\u5BB6\u4F19\u3002\u4F60\u8EAB\u4E0A\u6709\u548C\u4ED6\u4EEC\u76F8\u540C\u7684\u6C14\u5473\u3002"
  - speaker: 0
    content: "\u4ED6\u4EEC\uFF1F"
  - speaker: 1
    content: "\u6211\u73B0\u5728\u6CA1\u65F6\u95F4\u62DB\u5F85\u4F60\uFF0C\u6628\u665A\u7684\u5BB4\u4F1A\u592A\u5435\u95F9\u4E86\u3002\u6211\u8981\u8865\u89C9\u3002"
  - speaker: 0
    content: "\u7B49\u7B49\uFF0C\u4F60\u8EAB\u4E0A\u7684\u6BEF\u5B50\u597D\u773C\u719F\uFF0C\u8FD9\u662F\u963F\u745F\u7684\u624B\u5DFE\uFF01"
  - speaker: 1
    content: "\u4F60\u8BF4\u7684\u662F\u6628\u5929\u5BB4\u4F1A\u7684\u4E3B\u89D2\uFF0C\u90A3\u4E2A\u8FC7\u751F\u65E5\u7684\u5C0F\u7537\u5B69\u5417\uFF1F\u771F\u4E0D\u77E5\u9053\u4ED6\u662F\u600E\u4E48\u53D7\u7684\u4E86\u7684\u3002"
  - speaker: 1
    content: "\u4E0D\u8FC7\u90A3\u4E2A\u5B69\u5B50\u6211\u5012\u4E0D\u8BA8\u538C\uFF0C\u4ED6\u5E38\u5E38\u6765\u770B\u6211\uFF0C\u8FD8\u7ED9\u6211\u6BEF\u5B50\u548C\u98DF\u7269\u3002\u597D\u4E86\uFF0C\u4F60\u8D76\u7D27\u79BB\u5F00\u5427\uFF01"
