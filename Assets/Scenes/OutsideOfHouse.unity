  _crowSpine: {fileID: 296947751}
  _dialoguePoint: {x: -4.98, y: 6.43}
  _triggerRadius: 1.2
  _dialogueUI: {fileID: 538648654}
  _lines:
  - speaker: 1
    content: "\u4F60\u597D\uFF01\u73A9\u5076\u5C0F\u59D0\u3002\u6628\u5929\u90A3\u573A\u5BB4\u4F1A\u53EF\u771F\u662F\u76DB\u5927\uFF01"
  - speaker: 1
    content: "\u90A3\u4E9B\u8863\u7740\u9C9C\u4EAE\u7684\u5927\u4EBA\u7269\u8D70\u8FDB\u90A3\u6837\u8C6A\u534E\u7684\u5927\u623F\u5B50\uFF0C\u771F\u662F\u53EB\u9E26\u65E0\u6BD4\u7FA1\u6155\uFF01"
  - speaker: 1
    content: "\u8981\u662F\u6211\u7684\u5DE2\u7A74\u4E5F\u80FD\u90A3\u6837\u95EA\u4EAE\uFF0C\u5373\u4F7F\u662F\u4E00\u70B9\u70B9\uFF0C\u6211\u4E5F\u5FC3\u6EE1\u610F\u8DB3\u4E86\uFF01"
  - speaker: 0
    content: "\u54E6\uFF1F\u662F\u5417\uFF1F"
  - speaker: 1
    content: "\u90A3\u662F\uFF01\u4F60\u4E5F\u89C9\u5F97\u5F88\u4E0D\u9519\u5427\uFF01"
  - speaker: 1
    content: "\u6211\u53EF\u4E0D\u50CF\u697C\u4E0B\u90A3\u53EA\u732B\uFF0C\u660E\u660E\u7FA1\u6155\u8FD8\u8981\u88C5\u4F5C\u4E00\u526F\u4E0D\u5728\u610F\u7684\u6837\u5B50\u3002"
  - speaker: 1
    content: "\u8BDD\u8BF4\u56DE\u6765\uFF0C\u6211\u5728\u5FD9\u7740\u7B51\u5DE2\u5462\uFF0C\u4F60\u53EF\u4EE5\u5E2E\u6211\u627E\u4E00\u4E9B\u4EAE\u95EA\u95EA\u5417\uFF1F"
  - speaker: 0
    content: "\u5F53\u7136\u53EF\u4EE5\u3002"
  _flyWhenWindowOpens: 0
  _windowOpenStateKey: outside_window_open
  _introDialogueCompleteFlag: crow_intro_dialogue_done
