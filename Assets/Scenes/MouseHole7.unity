  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dde69b1329ffe7b47a684f6978861d40, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _currentScene: MouseHole7
  _dialogueUI: {fileID: 169568442}
  _mouseController: {fileID: 313332335}
  _hankySceneObject: {fileID: 1174847683}
  _hankyItem: {fileID: 11400000, guid: 1ba29845111158f46bf0431b86ea828f, type: 2}
  _txtMouseThinking: {fileID: 1156959446}
  _playerBubbleText: "\u54E6\uFF01\u963F\u745F\u7684\u624B\u5E15\uFF01"
  _playerBubbleDuration: 1.5
  _dialogueLines:
  - speaker: 1
    content: "\u563F\uFF01\u653E\u4E0B\u4F60\u7684\u810F\u624B\u4F60\u8FD9\u4E2A\u5C0F\u5077\uFF01"
  - speaker: 0
    content: "\u54E6\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u4E0D\u77E5\u9053\u8FD9\u662F\u60A8\u7684\u4E1C\u897F\u3002"
  - speaker: 1
    content: "\u8FD9\u5F53\u7136\u662F\u6211\u7684\u4E1C\u897F\uFF01\u8FD9\u91CC\u8FD8\u662F\u6211\u5BB6\u5462\uFF01"
  - speaker: 0
    content: "\u662F\u5417\uFF1F\u6211\u597D\u50CF\u770B\u89C1\u8FC7\u4E00\u4E2A\u519B\u5B98\u62FF\u7740\u8FD9\u4E2A\u624B\u5E15\u5462\u2026\u2026"
  - speaker: 0
    content: "\u5973\u58EB\uFF0C\u4E00\u4E2A\u5C0F\u5077\u4E5F\u53EF\u4EE5\u53CD\u8FC7\u6765\u6307\u8D23\u522B\u4EBA\u5417\uFF1F"
  - speaker: 1
    content: "\u54E6\u4F60\u600E\u4E48\u80FD\u8840\u53E3\u55B7\u4EBA\u5462\uFF01"
  - speaker: 0
    content: "\uFF01\u8BF4\u5230\u8840\uFF0C\u60A8\u77E5\u9053\u8FD9\u624B\u5E15\u4E0A\u7684\u8840\u662F\u8C01\u7684\u5417\uFF1F"
  - speaker: 1
    content: "\u8840\uFF01\uFF1F\u54E6\uFF0C\u6211\u8FD8\u4EE5\u4E3A\u8FD9\u662F\u7EE3\u82B1\u5462\u3002"
  - speaker: 1
    content: "\u8FD9\u4E48\u8BF4\u7684\u8BDD\uFF0C\u5F53\u65F6\u4ED6\u662F\u5728\u54B3\u55FD\uFF0C\u7136\u540E\u8FD9\u4E2A\u624B\u5E15\u5C31\u6389\u4E0B\u6765\u5230\u6211\u7684\u80CC\u4E0A\u5566\u3002"
  - speaker: 1
    content: "\u6211\u5F53\u65F6\u7740\u6025\u8DD1\u8DEF\uFF0C\u4E0D\u662F\u8981\u5077\u4ED6\u7684\uFF0C\u4F60\u559C\u6B22\u9001\u4F60\u597D\u4E86\u3002"
  _sequenceCompleteFlag: mousehole7_hanky_sequence_done
